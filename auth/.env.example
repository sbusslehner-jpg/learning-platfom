# ============================================================
# Keycloak-Stack – Vorlage. Kopieren nach auth/.env und Werte ersetzen.
# Diese Datei enthält KEINE echten Geheimnisse und darf im Repository liegen.
# `auth/.env` selbst ist über .gitignore ausgeschlossen.
# ============================================================

# Instanz-Administrator der Keycloak-Konsole (nicht der Plattform-Admin!)
KC_ADMIN=kcadmin
KC_ADMIN_PASSWORD=bitte-langes-passwort-setzen

# Datenbank
KC_DB_PASSWORD=bitte-langes-passwort-setzen

# Secret des vertraulichen Backend-Clients `platform-backend`.
# Muss mit der Netlify-Variable KEYCLOAK_BACKEND_CLIENT_SECRET übereinstimmen.
PLATFORM_BACKEND_SECRET=bitte-langes-secret-setzen
