# Supabase-Projekt (Settings → API im Supabase-Dashboard)
# Ohne diese Variablen läuft die App mit eingebauten Demo-Daten.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>

# Hinweis: Der service_role-Key gehört NIEMALS hierher oder in das Frontend.
# Er wird ausschließlich serverseitig verwendet (Übersetzungs-Worker, Redaktion).
